<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 纸张底色：2026-10-26 实测真墨水屏照片（逐像素统计 98x48 取平均）。
         #D7D6D6 = R215 G214 B214，RGB 几乎相等 → 真·中性灰；
         之前用的 #F0ECE3 是暖调米色，色相就是错的（墨水屏不偏暖）。
         注意：照片受环境光影响，若在不同光线下对比仍觉得偏，可再微调。 -->
    <color name="paper">#B8B6B5</color>
    <!-- 文字：刻意不用纯黑，纯黑对比过强易有眩光 -->
    <color name="ink">#2B2B2B</color>
    <!-- 次要文字（章节名 / 页码 / 电量）：随底色改为中性灰 -->
    <color name="ink_secondary">#6B6A69</color>
    <color name="divider">#A09E9D</color>
    <!-- 图标底色，与纸色一致 -->
    <color name="launcher_bg">#B8B6B5</color>
</resources>
